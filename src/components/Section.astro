---
interface Props {
  eyebrow?: string;
  title?: string;
  intro?: string;
  class?: string;
}
const { eyebrow, title, intro, class: cls = "" } = Astro.props;
---
<section class={`max-w-6xl mx-auto px-6 py-16 ${cls}`}>
  {eyebrow && <p class="font-display text-xs uppercase tracking-[0.16em] text-red-bright">{eyebrow}</p>}
  {title && <h2 class="text-3xl md:text-4xl mt-2 max-w-2xl">{title}</h2>}
  {intro && <p class="text-graytext mt-4 max-w-2xl text-lg">{intro}</p>}
  <slot />
</section>
