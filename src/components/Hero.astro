---
import { site } from "../data/site";
const chips = ["Real Estate", "Professional Services", "E-commerce", "Construction"];
---
<section class="bg-gradient-to-b from-white to-cream/40">
  <div class="max-w-6xl mx-auto px-6 py-16 md:py-20 grid md:grid-cols-[1.3fr_0.7fr] gap-12 items-center">
    <div>
      <p class="font-display font-semibold text-[13px] tracking-[0.16em] uppercase text-red-bright">{site.heroEyebrow}</p>
      <h1 class="text-4xl md:text-5xl mt-4 leading-[1.08]">
        Finance, operations &amp; AI — run <span class="hl">remotely</span>, built for how you work.
      </h1>
      <p class="text-lg text-graytext mt-5 max-w-xl">{site.heroSub}</p>
      <div class="flex flex-wrap gap-3 mt-8">
        <a href={site.bookingUrl} class="btn btn-primary">Book a fit call</a>
        <a href="/services/finance-accounting" class="btn btn-ghost">See how we work</a>
      </div>
      <div class="flex flex-wrap gap-2 mt-8">
        {chips.map((c) => (
          <span class="text-[13px] font-medium px-3 py-1.5 rounded-full border border-line bg-white text-ink/70">{c}</span>
        ))}
        <span class="text-[13px] font-medium px-3 py-1.5 rounded-full border border-[#e7cfa0] bg-gold/15 text-gold-deep">&amp; more</span>
      </div>
    </div>

    <div class="rounded-2xl border border-line bg-cream p-7 relative overflow-hidden">
      <div class="absolute top-0 left-0 w-1.5 h-full bg-gradient-to-b from-red-deep to-gold"></div>
      <p class="font-display font-bold text-2xl text-red-deep">3 pillars</p>
      <p class="text-sm text-graytext mb-4">Finance · Operations · AI</p>
      <p class="font-display font-bold text-2xl text-red-deep">Industry-fluent</p>
      <p class="text-sm text-graytext mb-4">Real estate, services, e-commerce &amp; more</p>
      <p class="font-display font-bold text-2xl text-red-deep">100% remote</p>
      <p class="text-sm text-graytext">Bilingual · Nationwide</p>
    </div>
  </div>
</section>
