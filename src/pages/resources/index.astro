---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import Section from "../../components/Section.astro";
import CtaBand from "../../components/CtaBand.astro";
import { getCollection } from "astro:content";
import { site } from "../../data/site";

const showDrafts = import.meta.env.SHOW_DRAFTS === "true";
const posts = (await getCollection("resources", ({ data }) => showDrafts || !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });

const blogLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: `${site.name} — Resources`,
  url: `${site.domain}/resources`,
  description:
    "Practical guidance on bookkeeping, controller and fractional-CFO support, business operations, and automation.",
  inLanguage: "en-US",
  publisher: { "@type": "Organization", name: site.name, url: site.domain },
};
---
<Base
  title={`Resources & Insights | ${site.name}`}
  description="Practical guidance on bookkeeping, controller and fractional-CFO support, business operations, and automation — from LPR Business Services."
  jsonLd={[blogLd]}
>
  <PageHero
    eyebrow="Resources"
    title="Insights for a back office that works."
    sub="Practical guidance on finance, operations, and the systems that keep a growing business running — written by the people who do the work."
  />

  <Section>
    {posts.length === 0 ? (
      <p class="text-graytext text-lg mt-6 max-w-2xl">
        New articles are on the way. Check back soon — or
        <a href="/contact" class="text-red-deep font-medium hover:underline">reach out</a>
        with a question you'd like us to cover.
      </p>
    ) : (
      <ul class="grid md:grid-cols-2 gap-6 mt-8">
        {posts.map((post) => (
          <li class="rounded-xl border border-line bg-white p-6 flex flex-col">
            <div class="text-xs uppercase tracking-[0.14em] text-gold-deep font-display font-semibold">
              {post.data.eyebrow}
            </div>
            <a href={`/resources/${post.id}`} class="mt-2 block">
              <h2 class="font-display text-xl text-ink leading-snug hover:text-red-deep transition-colors">
                {post.data.title}
              </h2>
            </a>
            <p class="text-graytext mt-3 leading-relaxed flex-1">{post.data.description}</p>
            <div class="mt-5 flex items-center justify-between text-sm text-graytext">
              <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
              <a href={`/resources/${post.id}`} class="text-red-deep font-medium hover:underline">Read →</a>
            </div>
          </li>
        ))}
      </ul>
    )}
  </Section>

  <CtaBand />
</Base>
