---
import "../styles/global.css";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
		<title>LPR — toolchain smoke test</title>
	</head>
	<body class="bg-cream">
		<main class="max-w-3xl mx-auto p-12">
			<p class="font-[var(--font-display)] uppercase tracking-widest text-sm text-red-bright">Brand token smoke test</p>
			<h1 class="text-5xl mt-3 text-ink">Finance, operations &amp; AI — run <span class="hl">remotely</span>.</h1>
			<p class="wordmark text-2xl text-red-deep mt-4">La Piedra Roja</p>
			<div class="mt-6 flex gap-3">
				<a class="btn btn-primary">Book a fit call</a>
				<a class="btn btn-ghost">See how we work</a>
			</div>
		</main>
	</body>
</html>
