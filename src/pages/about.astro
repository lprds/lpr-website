---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import Section from "../components/Section.astro";
import CtaBand from "../components/CtaBand.astro";
import { site } from "../data/site";

const expertise = [
  "Bookkeeping, controller, and fractional-CFO work in QuickBooks, Xero, Sage 100 Contractor, and Ramp",
  "Construction and project-based finance — job costing, WIP, insurance audits",
  "Operations and admin: process design, SOPs, and back-office management",
  "Bringing businesses from low-tech to high-tech, alongside your existing IT team",
  "Bilingual service — English and Spanish",
];

const personLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.founder,
  jobTitle: site.founderTitle,
  worksFor: { "@type": "ProfessionalService", name: site.name, url: site.domain },
  url: `${site.domain}/about`,
  sameAs: [site.linkedin],
};
const aboutLd = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  name: `About ${site.name}`,
  url: `${site.domain}/about`,
};
---
<Base
  title={`About LPR Business Services | ${site.founder}, ${site.founderTitle}`}
  description="LPR Business Services is a remote finance, operations, and modernization partner founded by Danielle Stone — bilingual, nationwide, and built around clarity, intention, and systems that actually work."
  jsonLd={[personLd, aboutLd]}
>
  <PageHero
    eyebrow="About LPR"
    title="Financial clarity, run with intention."
    sub="LPR Business Services brings finance, operations, and modern systems together under one roof — delivered remotely, in English and Spanish, with the calm of a back office that actually works."
  />

  <Section title="Why LPR exists">
    <div class="max-w-2xl mt-6 space-y-4 text-graytext leading-relaxed text-lg">
      <p>
        Most growing businesses don't need a full finance department, an office manager, and a
        separate systems consultant — they need one trusted partner who can do all three and make
        them work together. That's the gap LPR was built to fill.
      </p>
      <p>
        Founded by {site.founder}, LPR pairs hands-on bookkeeping and controller work with
        forward-looking, CFO-level guidance and the operational support that keeps a business running
        day to day. We've worked with businesses at every stage — from solo founders who need clean
        books and reliable reporting to established companies ready for cash-flow forecasting, job
        costing, and strategic planning — across real estate, professional services, e-commerce, and
        construction.
      </p>
      <p>
        We're also the bridge from low-tech to high-tech. Plenty of businesses still run on
        spreadsheets, paper, and disconnected tools, and the jump to modern systems feels daunting.
        LPR makes that jump for you — meeting your business where it is and working alongside your
        existing IT team, however big or small, to bring everything online and up to date. You don't
        have to worry about how it gets done; that's our job.
      </p>
      <p>
        Our approach is deliberately intentional: we focus your resources on their highest needs,
        build systems that hold up under pressure, and keep technology in service of people. The
        result is financial clarity and a back office you can stop worrying about.
      </p>
      <p>
        We work entirely remotely and serve clients nationwide, in English and Spanish — senior-level
        support delivered wherever your business runs, without the overhead of an in-house team.
      </p>
    </div>
  </Section>

  <div class="bg-cream/50 border-y border-line">
    <Section title="Where we go deep">
      <ul class="grid md:grid-cols-2 gap-4 mt-8">
        {expertise.map((e) => (
          <li class="rounded-xl border border-line bg-white p-5 flex gap-3">
            <span class="text-gold-deep font-display font-bold">✓</span>
            <span class="text-ink">{e}</span>
          </li>
        ))}
      </ul>
    </Section>
  </div>

  <CtaBand />
</Base>
